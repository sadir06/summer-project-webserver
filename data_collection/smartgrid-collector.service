[Unit]
Description=Smart Grid tick collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/REPLACE_USER/summer-project-webserver/data_collection
ExecStart=/home/REPLACE_USER/summer-project-webserver/data_collection/venv/bin/python collector.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
